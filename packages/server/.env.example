# Copy to .env for local development. Never commit the real .env (see .gitignore).

NODE_ENV=development
PORT=3000

# Local Postgres set up during Phase 0 (see docs/decisions.md Phase 0 addendum).
DATABASE_URL=postgresql://void_app:void_dev_local_only@localhost:5432/void_dev

# Session cookie signing secret. Generate a real random value per environment;
# never reuse this placeholder outside local dev.
SESSION_SECRET=dev-only-change-me-00000000000000000000000000000000

# Error tracking (ID: Sentry-equivalent, provider TBD per decisions.md).
# Left blank locally; error reporting no-ops (logs only) when unset.
SENTRY_DSN=
